diff --git a/pkg/server/service/service_datagram_tunnel.go b/pkg/server/service/service_datagram_tunnel.go
new file mode 100644
index 00000000..27c58405
--- /dev/null
+++ b/pkg/server/service/service_datagram_tunnel.go
@@ -0,0 +1,117 @@
+package service
+
+import (
+	"context"
+	"fmt"
+	"math/rand/v2"
+	"net"
+	"net/http"
+
+	webtransport "github.com/quic-go/webtransport-go"
+	"github.com/rs/zerolog/log"
+
+	"github.com/traefik/traefik/v3/pkg/config/dynamic"
+)
+
+type wtServerKeyType struct{}
+
+var WTServerContextKey = wtServerKeyType{}
+
+func InjectWTServer(h http.Handler, wts *webtransport.Server) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		log.Debug().Msgf("Got request: %T", w)
+		ctx := context.WithValue(r.Context(), WTServerContextKey, wts)
+		h.ServeHTTP(w, r.WithContext(ctx))
+	})
+}
+
+type datagramTunnelHandler struct {
+	servers []dynamic.DatagramTunnelServer
+}
+
+func newDatagramTunnelHandler(cfg *dynamic.DatagramTunnelService) (http.Handler, error) {
+	if len(cfg.Servers) == 0 {
+		return nil, fmt.Errorf("datagramTunnel service has no servers configured")
+	}
+	return &datagramTunnelHandler{servers: cfg.Servers}, nil
+}
+
+func (h *datagramTunnelHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	logger := log.Ctx(r.Context())
+	logger.Trace().Msgf("Got webtransport from %s", r.RemoteAddr)
+
+	wtSrv, ok := r.Context().Value(WTServerContextKey).(*webtransport.Server)
+	if !ok || wtSrv == nil {
+		http.Error(w, "WebTransport not available on this entry point (HTTP/3 only)", http.StatusServiceUnavailable)
+		return
+	}
+
+	sess, err := wtSrv.Upgrade(w, r)
+	if err != nil {
+		logger.Error().Err(err).Msg("WebTransport upgrade failed")
+		http.Error(w, "WebTransport upgrade: "+err.Error(), http.StatusBadRequest)
+		return
+	}
+	defer func() {
+		if err := recover(); err != nil {
+			sess.CloseWithError(1, "Internal server error")
+			panic(err)
+		}
+		sess.CloseWithError(0, "")
+	}()
+
+	idx := rand.IntN(len(h.servers))
+	addr := h.servers[idx].Address
+
+	udpConn, err := net.Dial("udp", addr)
+	if err != nil {
+		logger.Error().Err(err).Str("addr", addr).Msg("Failed to dial UDP backend")
+		_ = sess.CloseWithError(1, "backend unavailable")
+		return
+	}
+	defer udpConn.Close()
+
+	ctx := sess.Context()
+
+	err_chan := make(chan error)
+
+	// WebTransport datagram → UDP backend.
+	go func() {
+		for {
+			data, err := sess.ReceiveDatagram(ctx)
+			if err != nil {
+				err_chan <- err
+				return
+			}
+			if _, err := udpConn.Write(data); err != nil {
+				err_chan <- err
+				return
+			}
+		}
+	}()
+
+	go func() {
+		buf := make([]byte, 65535)
+		for {
+			n, err := udpConn.Read(buf)
+			if err != nil {
+				err_chan <- err
+				return
+			}
+			if err := sess.SendDatagram(buf[:n]); err != nil {
+				err_chan <- err
+				return
+			}
+		}
+	}()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case err := <-err_chan:
+			log.Error().Msgf("An error occurred in udp tunneling: %s", err)
+			return
+		}
+	}
+}
