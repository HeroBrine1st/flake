diff --git a/pkg/config/dynamic/datagram_tunnel_config_test.go b/pkg/config/dynamic/datagram_tunnel_config_test.go
new file mode 100644
index 00000000..4f69bfe8
--- /dev/null
+++ b/pkg/config/dynamic/datagram_tunnel_config_test.go
@@ -0,0 +1,44 @@
+package dynamic_test
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v3"
+
+	"github.com/traefik/traefik/v3/pkg/config/dynamic"
+)
+
+func TestDatagramTunnelServiceYAML(t *testing.T) {
+	raw := `
+datagramTunnel:
+  servers:
+    - address: "127.0.0.1:9001"
+    - address: "127.0.0.1:9002"
+`
+	var svc dynamic.Service
+	err := yaml.Unmarshal([]byte(raw), &svc)
+	require.NoError(t, err)
+	require.NotNil(t, svc.DatagramTunnel)
+	assert.Len(t, svc.DatagramTunnel.Servers, 2)
+	assert.Equal(t, "127.0.0.1:9001", svc.DatagramTunnel.Servers[0].Address)
+}
+
+func TestDatagramTunnelServiceDeepCopy(t *testing.T) {
+	orig := &dynamic.Service{
+		DatagramTunnel: &dynamic.DatagramTunnelService{
+			Servers: []dynamic.DatagramTunnelServer{
+				{Address: "10.0.0.1:4000"},
+				{Address: "10.0.0.2:4000"},
+			},
+		},
+	}
+	cp := orig.DeepCopy()
+	require.NotNil(t, cp.DatagramTunnel)
+	assert.Equal(t, orig.DatagramTunnel.Servers, cp.DatagramTunnel.Servers)
+
+	// Mutating the original slice must not affect the copy.
+	orig.DatagramTunnel.Servers[0].Address = "changed"
+	assert.Equal(t, "10.0.0.1:4000", cp.DatagramTunnel.Servers[0].Address)
+}
