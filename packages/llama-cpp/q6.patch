diff --git a/ggml/src/ggml-cuda/cpy-utils.cuh b/ggml/src/ggml-cuda/cpy-utils.cuh
index 7697c292d..013fb2788 100644
--- a/ggml/src/ggml-cuda/cpy-utils.cuh
+++ b/ggml/src/ggml-cuda/cpy-utils.cuh
@@ -134,6 +134,58 @@ static __device__ void quantize_f32_q5_1_block(const float * __restrict__ x, blo
     memcpy(y->qh, &qh, sizeof(qh));
 }
 
+static __device__ void quantize_f32_q6_0_block(const float * __restrict__ x, block_q6_0 * __restrict__ y) {
+    float amax = 0.0f;
+    float vmax = 0.0f;
+
+    for (int j = 0; j < QK6_0; ++j) {
+        const float v = x[j];
+        if (amax < fabsf(v)) {
+            amax = fabsf(v);
+            vmax = v;
+        }
+    }
+
+    float d = vmax / -32.0f;
+    const float id = d ? 1.0f / d : 0.0f;
+
+    float sumqx = 0.0f;
+    float sumq2 = 0.0f;
+
+#pragma unroll
